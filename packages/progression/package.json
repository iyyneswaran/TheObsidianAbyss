{
  "name": "@obsidian/progression",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "db:validate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --conditions=development --import tsx src/seed.ts"
  },
  "dependencies": {
    "@obsidian/game-core": "workspace:*",
    "@prisma/client": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
